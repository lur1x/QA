Purpose: купить_дом, новостройка, гараж, коммерческая, построить_дом, рефинансирование, наличные_под_залог, купить_землю, вторичка
Program: базовая_15.5%, семейная_6%, IT_6%, военная_18.6%
Interface: Стандартный, Военный
Cost: 1, 50, 100
Deposit: 5, 6, 10, 15, 20, 43, 67
Term: 1, 15, 30
SalaryOnSber: да, нет
DiscountPayment: да, нет
DiscountPartnership: да, нет
DiscountPersonal: да, нет

# Военная ипотека - всегда Военный интерфейс
IF [Program] = "военная_18.6%" THEN [Interface] = "Военный";
IF [Interface] = "Военный" THEN [Program] = "военная_18.6%";
IF [Interface] = "Стандартный" THEN [Program] <> "военная_18.6%";

# Коммерческая - только Базовая, срок до 25 лет
IF [Purpose] = "коммерческая" THEN [Program] = "базовая_15.5%";
IF [Purpose] = "коммерческая" THEN [Term] <= 20;

# Рефинансирование - Базовая или Семейная
IF [Purpose] = "рефинансирование" THEN [Program] IN {"базовая_15.5%", "семейная_6%"};

# Построить дом - Базовая, Семейная или IT
IF [Purpose] = "построить_дом" THEN [Program] IN {"базовая_15.5%", "семейная_6%", "IT_6%"};

# Наличные под залог - только Базовая
IF [Purpose] = "наличные_под_залог" THEN [Program] = "базовая_15.5%";

# Для Семейной и IT минимальный взнос - 6%
IF [Program] = "семейная_6%" THEN [Deposit] >= 6;
IF [Program] = "IT_6%" THEN [Deposit] >= 6;

# Для Базовой минимальный взнос - 15%
IF [Program] = "базовая_15.5%" THEN [Deposit] >= 15;
